{
  "version": "1.2.0",
  "ownershipModel": "dogtagday-source-of-truth",
  "architectureMode": "unified-shell-around-legacy",
  "cutoverPolicy": "keep-legacy-live-until-replacement-proven",
  "sourceOfTruth": {
    "repository": "rshure001/DogTagDay",
    "branch": "main"
  },
  "integrationModel": {
    "strategy": "wrap-then-absorb",
    "principle": "Build the Dog Tag Day control plane around working legacy components, expose one control interface, then replace internals lane-by-lane without creating a permanent second system.",
    "cutover": "one_lane_at_a_time",
    "rollback": "retain_legacy_fallback_until_health_and_publish_test_pass"
  },
  "modules": {
    "browserControl": {
      "state": "source_owned",
      "role": "outer-control-layer",
      "legacyFallback": "appdeploy-browser-connector"
    },
    "publishingEngine": {
      "state": "source_owned",
      "role": "platform-publishing-core",
      "legacyFallback": "appdeploy-direct-publishing-engine"
    },
    "broadcastControl": {
      "state": "source_owned",
      "role": "queue-and-rotation"
    },
    "tiktok": {
      "state": "migration_pending",
      "legacyFallback": "appdeploy"
    },
    "youtube": {
      "state": "connector_pending"
    },
    "meta": {
      "state": "connector_pending"
    },
    "email": {
      "state": "hardening_pending"
    },
    "website": {
      "state": "legacy_live"
    },
    "logs": {
      "state": "foundation_ready"
    },
    "secrets": {
      "state": "secure_store_required"
    }
  }
}