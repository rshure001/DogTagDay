{
  "version": "1.1.0",
  "ownershipModel": "dogtagday-source-of-truth",
  "cutoverPolicy": "keep-legacy-live-until-replacement-proven",
  "sourceOfTruth": {
    "repository": "rshure001/DogTagDay",
    "branch": "main"
  },
  "modules": {
    "browserControl": {
      "state": "source_owned",
      "role": "outer-control-layer",
      "legacyFallback": "appdeploy-browser-connector"
    },
    "publishingEngine": {
      "state": "source_owned",
      "role": "platform-publishing-core",
      "legacyFallback": "appdeploy-direct-publishing-engine"
    },
    "broadcastControl": {
      "state": "source_owned",
      "role": "queue-and-rotation"
    },
    "tiktok": {
      "state": "migration_pending",
      "legacyFallback": "appdeploy"
    },
    "youtube": {
      "state": "connector_pending"
    },
    "meta": {
      "state": "connector_pending"
    },
    "email": {
      "state": "hardening_pending"
    },
    "website": {
      "state": "legacy_live"
    },
    "logs": {
      "state": "foundation_ready"
    },
    "secrets": {
      "state": "secure_store_required"
    }
  }
}